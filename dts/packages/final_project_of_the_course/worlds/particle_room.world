<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    
    <include>
      <uri>model://sun</uri>
      <pose>0 0 10 0 0 0</pose>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://particle_room</uri>
      <pose>0 0 0.2 0 0 0</pose> 
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
  <ambient>0.4 0.4 0.4 1.0</ambient> <background>0.3 0.3 0.3 1.0</background>
  <shadows>true</shadows>
   </scene>
    </world>
  
  
</sdf>
